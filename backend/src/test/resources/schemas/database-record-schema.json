{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["table", "rows"],
  "properties": {
    "table": { "type": "string" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "risk_score"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "risk_score": { "type": "number" }
        }
      }
    }
  }
}